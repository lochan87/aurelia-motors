generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Physical dealership location. Inventory, price books, and certified used
/// listings all belong to a showroom so availability stays location-specific.
model Showroom {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  city      String   @default("Lucknow")
  state     String   @default("Uttar Pradesh")
  timezone  String   @default("Asia/Kolkata")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory              NewVehicleInventory[]
  priceBooks             PriceBook[]
  usedVehicles           UsedVehicle[]
  demoVehicles           DemoVehicle[]
  testDriveAppointments TestDriveAppointment[]
  workshops              Workshop[]
  staffAssignments       StaffLocationAssignment[]
  leads                  Lead[]

  @@index([city, isActive])
  @@map("showrooms")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum BodyType {
  HATCHBACK
  SEDAN
  SUV
  CROSSOVER
}

enum SpecificationGroup {
  ENGINE
  PERFORMANCE
  DIMENSIONS
  SAFETY
  COMFORT
  TECHNOLOGY
}

model VehicleModel {
  id          String   @id @default(cuid())
  slug        String   @unique
  make        String
  name        String
  bodyType    BodyType
  summary     String
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants     VehicleVariant[]
  colours      VehicleColour[]
  images       VehicleImage[]
  usedVehicles UsedVehicle[]
  leads        Lead[]

  @@index([make, isActive])
  @@index([bodyType, isActive])
  @@map("vehicle_models")
}

model VehicleVariant {
  id               String       @id @default(cuid())
  slug             String       @unique
  modelId          String
  name             String
  fuelType         FuelType
  transmission     Transmission
  engineCapacityCc Int?
  powerBhp         Int?
  torqueNm         Int?
  seatingCapacity  Int          @default(5)
  isActive         Boolean      @default(true)
  sortOrder        Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  model                  VehicleModel           @relation(fields: [modelId], references: [id], onDelete: Cascade)
  specifications         VehicleSpecification[]
  priceEntries           PriceEntry[]
  inventory              NewVehicleInventory[]
  usedVehicles           UsedVehicle[]
  demoVehicles           DemoVehicle[]
  testDriveAppointments TestDriveAppointment[]
  leads                  Lead[]

  @@unique([modelId, name])
  @@index([modelId, isActive, sortOrder])
  @@index([fuelType, isActive])
  @@map("vehicle_variants")
}

model VehicleColour {
  id        String   @id @default(cuid())
  modelId   String
  name      String
  hexCode   String
  finish    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  model     VehicleModel          @relation(fields: [modelId], references: [id], onDelete: Cascade)
  inventory NewVehicleInventory[]

  @@unique([modelId, name])
  @@index([modelId, isActive, sortOrder])
  @@map("vehicle_colours")
}

model VehicleImage {
  id        String   @id @default(cuid())
  modelId   String
  url       String
  altText   String
  caption   String?
  credit    String?
  width     Int
  height    Int
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  model VehicleModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, sortOrder])
  @@index([modelId, isPrimary])
  @@map("vehicle_images")
}

model VehicleSpecification {
  id        String             @id @default(cuid())
  variantId String
  group     SpecificationGroup
  label     String
  value     String
  sortOrder Int                @default(0)

  variant VehicleVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, group, label])
  @@index([variantId, group, sortOrder])
  @@map("vehicle_specifications")
}

// ---------------------------------------------------------------------------
// New-car inventory
// ---------------------------------------------------------------------------

enum StockStatus {
  AVAILABLE
  RESERVED
  SOLD
  IN_TRANSIT
}

model NewVehicleInventory {
  id              String      @id @default(cuid())
  stockNumber     String      @unique
  showroomId      String
  variantId       String
  colourId        String?
  status          StockStatus @default(AVAILABLE)
  manufactureYear Int
  odometerKm      Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  showroom Showroom       @relation(fields: [showroomId], references: [id], onDelete: Restrict)
  variant  VehicleVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  colour   VehicleColour? @relation(fields: [colourId], references: [id], onDelete: SetNull)

  @@index([showroomId, status])
  @@index([variantId, status])
  @@index([colourId])
  @@map("new_vehicle_inventory")
}

// ---------------------------------------------------------------------------
// Versioned on-road pricing
// ---------------------------------------------------------------------------

enum PriceBookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PriceKind {
  SAMPLE_ESTIMATE
  PUBLISHED
}

enum PriceComponentCategory {
  ROAD_TAX
  INSURANCE
  REGISTRATION
  ACCESSORIES
  OTHER
}

enum PriceCalculation {
  FIXED
  PERCENT_OF_EXSHOWROOM
}

model PriceBook {
  id            String          @id @default(cuid())
  code          String          @unique
  name          String
  showroomId    String?
  status        PriceBookStatus @default(DRAFT)
  isSample      Boolean         @default(true)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  publishedAt   DateTime?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  showroom Showroom?    @relation(fields: [showroomId], references: [id], onDelete: SetNull)
  entries  PriceEntry[]

  @@index([showroomId, status, effectiveFrom])
  @@index([status, effectiveFrom])
  @@map("price_books")
}

model PriceEntry {
  id              String    @id @default(cuid())
  priceBookId     String
  variantId       String
  exShowroomPaise Int
  priceKind       PriceKind @default(SAMPLE_ESTIMATE)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  priceBook  PriceBook        @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  variant    VehicleVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  components PriceComponent[]

  @@unique([priceBookId, variantId])
  @@index([variantId])
  @@map("price_entries")
}

model PriceComponent {
  id              String                 @id @default(cuid())
  priceEntryId    String
  code            String
  label           String
  category        PriceComponentCategory
  calculation     PriceCalculation
  amountPaise     Int?
  rateBasisPoints Int?
  isOptional      Boolean                @default(false)
  sortOrder       Int                    @default(0)

  priceEntry PriceEntry @relation(fields: [priceEntryId], references: [id], onDelete: Cascade)

  @@unique([priceEntryId, code])
  @@index([priceEntryId, sortOrder])
  @@map("price_components")
}

// ---------------------------------------------------------------------------
// Certified pre-owned
// ---------------------------------------------------------------------------

enum InspectionRating {
  PASS
  ATTENTION
  FAIL
}

model UsedVehicle {
  id                       String       @id @default(cuid())
  slug                     String       @unique
  modelId                  String?
  variantId                String?
  showroomId               String
  make                     String
  modelName                String
  variantName              String
  registrationYear         Int
  registrationMonth        Int?
  mileageKm                Int
  fuelType                 FuelType
  transmission             Transmission
  ownershipCount           Int          @default(1)
  colourName               String
  pricePaise               Int
  priceKind                PriceKind    @default(SAMPLE_ESTIMATE)
  stockStatus              StockStatus  @default(AVAILABLE)
  certified                Boolean      @default(true)
  registrationNumberMasked String
  description              String
  highlights               String[]
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  model       VehicleModel?           @relation(fields: [modelId], references: [id], onDelete: SetNull)
  variant     VehicleVariant?         @relation(fields: [variantId], references: [id], onDelete: SetNull)
  showroom    Showroom                @relation(fields: [showroomId], references: [id], onDelete: Restrict)
  inspections UsedVehicleInspection[]
  leads       Lead[]

  @@index([showroomId, stockStatus])
  @@index([registrationYear, mileageKm])
  @@index([fuelType, transmission])
  @@index([pricePaise])
  @@index([modelId])
  @@map("used_vehicles")
}

model UsedVehicleInspection {
  id              String   @id @default(cuid())
  usedVehicleId   String
  version         Int      @default(1)
  inspectedAt     DateTime
  inspectorName   String
  overallScore    Int
  summary         String
  reportReference String   @unique
  isCurrent       Boolean  @default(true)
  createdAt       DateTime @default(now())

  usedVehicle UsedVehicle          @relation(fields: [usedVehicleId], references: [id], onDelete: Cascade)
  items       UsedInspectionItem[]

  @@unique([usedVehicleId, version])
  @@index([usedVehicleId, isCurrent])
  @@map("used_vehicle_inspections")
}

model UsedInspectionItem {
  id           String           @id @default(cuid())
  inspectionId String
  category     String
  label        String
  rating       InspectionRating
  notes        String?
  sortOrder    Int              @default(0)

  inspection UsedVehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, label])
  @@index([inspectionId, sortOrder])
  @@map("used_inspection_items")
}

// ---------------------------------------------------------------------------
// Customers and Consents
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consents              CustomerConsent[]
  testDriveAppointments TestDriveAppointment[]
  serviceAppointments   ServiceAppointment[]
  leads                 Lead[]

  @@index([phone])
  @@index([email])
  @@map("customers")
}

model CustomerConsent {
  id            String   @id @default(cuid())
  customerId    String
  purpose       String
  noticeVersion String   @default("2026.1")
  granted       Boolean  @default(true)
  source        String   @default("WEBSITE")
  ipHash        String?
  grantedAt     DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, purpose])
  @@map("customer_consents")
}

// ---------------------------------------------------------------------------
// Demo Fleet & Test Drives
// ---------------------------------------------------------------------------

model DemoVehicle {
  id                 String   @id @default(cuid())
  showroomId         String
  variantId          String
  registrationNumber String
  vin                String?  @unique
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  showroom     Showroom               @relation(fields: [showroomId], references: [id], onDelete: Restrict)
  variant      VehicleVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  appointments TestDriveAppointment[]

  @@unique([showroomId, registrationNumber])
  @@index([showroomId, variantId, isActive])
  @@map("demo_vehicles")
}

enum TestDriveStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model TestDriveAppointment {
  id                  String          @id @default(cuid())
  bookingReference    String          @unique
  idempotencyKey      String          @unique
  showroomId          String
  variantId           String
  demoVehicleId       String
  customerId          String
  startTime           DateTime
  endTime             DateTime
  status              TestDriveStatus @default(CONFIRMED)
  driverLicenseNumber String?
  notes               String?
  cancellationReason  String?
  cancelledAt         DateTime?
  confirmationToken   String          @unique
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  showroom    Showroom       @relation(fields: [showroomId], references: [id], onDelete: Restrict)
  variant     VehicleVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  demoVehicle DemoVehicle    @relation(fields: [demoVehicleId], references: [id], onDelete: Restrict)
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([demoVehicleId, startTime, endTime, status])
  @@index([showroomId, startTime])
  @@index([customerId])
  @@index([bookingReference])
  @@map("test_drive_appointments")
}

// ---------------------------------------------------------------------------
// Service Workshops & Appointments
// ---------------------------------------------------------------------------

model Workshop {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  address       String
  city          String   @default("Lucknow")
  state         String   @default("Uttar Pradesh")
  timezone      String   @default("Asia/Kolkata")
  phone         String
  showroomId    String?
  baysCount     Int      @default(6)
  dailyCapacity Int      @default(24)
  slotCapacity  Int      @default(3)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  showroom       Showroom?                @relation(fields: [showroomId], references: [id], onDelete: SetNull)
  operatingHours WorkshopOperatingHours[]
  appointments   ServiceAppointment[]
  staffAssignments StaffLocationAssignment[]

  @@index([city, isActive])
  @@map("workshops")
}

model WorkshopOperatingHours {
  id                  String   @id @default(cuid())
  workshopId          String
  dayOfWeek           Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  opensAt             String   // e.g. "08:30"
  closesAt            String   // e.g. "18:30"
  slotDurationMinutes Int      @default(60)
  isOpen              Boolean  @default(true)

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@unique([workshopId, dayOfWeek])
  @@map("workshop_operating_hours")
}

model ServiceType {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  description         String
  durationMinutes     Int
  estimatedPricePaise Int?
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())

  appointments ServiceAppointment[]

  @@index([isActive, sortOrder])
  @@map("service_types")
}

enum ServiceStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ServiceAppointment {
  id                  String        @id @default(cuid())
  bookingReference    String        @unique
  idempotencyKey      String        @unique
  workshopId          String
  serviceTypeId       String
  customerId          String
  vehicleRegistration String
  vehicleModel        String
  vehicleYear         Int?
  vehicleMileageKm    Int?
  startTime           DateTime
  endTime             DateTime
  status              ServiceStatus @default(CONFIRMED)
  notes               String?
  cancellationReason  String?
  cancelledAt         DateTime?
  confirmationToken   String        @unique
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  workshop    Workshop    @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([workshopId, startTime, endTime, status])
  @@index([vehicleRegistration])
  @@index([customerId])
  @@index([bookingReference])
  @@map("service_appointments")
}

// ---------------------------------------------------------------------------
// Staff Authentication, RBAC, and Sessions
// ---------------------------------------------------------------------------

enum StaffRole {
  ADMIN
  SALES_CONSULTANT
  USED_CAR_STAFF
  SERVICE_ADVISOR
}

model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String?
  role         StaffRole
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions            StaffSession[]
  locationAssignments StaffLocationAssignment[]
  auditEvents         AuthenticationAuditEvent[]
  assignedLeads       Lead[]                     @relation("AssignedLeads")
  leadActivities      LeadActivity[]
  leadNotes           LeadNote[]
  leadStatusChanges   LeadStatusHistory[]
  leadImports         LeadImportBatch[]

  @@index([email, isActive])
  @@index([role, isActive])
  @@map("staff_users")
}

model StaffSession {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  staffUserId  String
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?
  ipHash       String?
  userAgent    String?

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId, revokedAt])
  @@index([expiresAt])
  @@map("staff_sessions")
}

model StaffLocationAssignment {
  id          String   @id @default(cuid())
  staffUserId String
  showroomId  String?
  workshopId  String?
  isPrimary   Boolean  @default(true)
  createdAt   DateTime @default(now())

  staffUser StaffUser  @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  showroom  Showroom?  @relation(fields: [showroomId], references: [id], onDelete: Cascade)
  workshop  Workshop?  @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@unique([staffUserId, showroomId])
  @@unique([staffUserId, workshopId])
  @@index([staffUserId])
  @@index([showroomId])
  @@index([workshopId])
  @@map("staff_location_assignments")
}

model AuthenticationAuditEvent {
  id          String   @id @default(cuid())
  staffUserId String?
  email       String
  eventType   String
  ipHash      String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  staffUser StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([staffUserId, createdAt])
  @@index([email, createdAt])
  @@index([eventType, createdAt])
  @@map("authentication_audit_events")
}

// ---------------------------------------------------------------------------
// Customer Enquiries & Lead CRM
// ---------------------------------------------------------------------------

enum LeadSource {
  WEB_ENQUIRY
  TEST_DRIVE_REQUEST
  SERVICE_REQUEST
  PORTAL_IMPORT
  PHONE_INQUIRY
  WALK_IN
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  QUALIFIED
  TEST_DRIVE_SCHEDULED
  NEGOTIATING
  WON
  LOST
}

enum PreferredContactMethod {
  PHONE
  EMAIL
  WHATSAPP
}

enum LeadType {
  NEW_CAR
  USED_CAR
  SERVICE
  GENERAL
}

model Lead {
  id                     String                 @id @default(cuid())
  leadReference          String                 @unique
  customerId             String
  type                   LeadType               @default(NEW_CAR)
  modelId                String?
  variantId              String?
  usedVehicleId          String?
  showroomId             String
  source                 LeadSource             @default(WEB_ENQUIRY)
  status                 LeadStatus             @default(NEW)
  assignedStaffId        String?
  preferredContactMethod PreferredContactMethod @default(PHONE)
  customerRequirements   String?
  externalLeadId         String?
  importBatchId          String?
  assignedAt             DateTime?
  firstResponseAt        DateTime?
  lastContactedAt        DateTime?
  closedAt               DateTime?
  lostReason             String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  customer      Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  model         VehicleModel?       @relation(fields: [modelId], references: [id], onDelete: SetNull)
  variant       VehicleVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  usedVehicle   UsedVehicle?        @relation(fields: [usedVehicleId], references: [id], onDelete: SetNull)
  showroom      Showroom            @relation(fields: [showroomId], references: [id], onDelete: Restrict)
  assignedStaff StaffUser?          @relation("AssignedLeads", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  importBatch   LeadImportBatch?    @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  activities    LeadActivity[]
  notes         LeadNote[]
  statusHistory LeadStatusHistory[]

  @@index([showroomId, status])
  @@index([assignedStaffId, status])
  @@index([status, createdAt])
  @@index([customerId])
  @@index([externalLeadId])
  @@index([importBatchId])
  @@index([type, status])
  @@map("leads")
}

model LeadActivity {
  id           String   @id @default(cuid())
  leadId       String
  staffUserId  String?
  activityType String   // STATUS_CHANGE, PHONE_CALL, EMAIL_SENT, WHATSAPP_MESSAGE, IN_PERSON_MEETING, ASSIGNMENT, REASSIGNMENT, NOTE_ADDED, IMPORT
  summary      String
  details      String?
  metadata     Json?
  createdAt    DateTime @default(now())

  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  staffUser StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([staffUserId])
  @@map("lead_activities")
}

model LeadNote {
  id          String   @id @default(cuid())
  leadId      String
  staffUserId String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([staffUserId])
  @@map("lead_notes")
}

model LeadStatusHistory {
  id               String      @id @default(cuid())
  leadId           String
  fromStatus       LeadStatus?
  toStatus         LeadStatus
  changedByStaffId String?
  reason           String?
  createdAt        DateTime    @default(now())

  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  staffUser StaffUser? @relation(fields: [changedByStaffId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([toStatus])
  @@map("lead_status_history")
}

model LeadImportBatch {
  id                String     @id @default(cuid())
  batchReference    String     @unique
  filename          String
  source            LeadSource @default(PORTAL_IMPORT)
  uploadedByStaffId String
  totalRows         Int
  importedRows      Int
  failedRows        Int
  duplicateRows     Int
  status            String     @default("COMPLETED") // COMPLETED, PARTIAL, FAILED
  errorSummary      Json?
  createdAt         DateTime   @default(now())

  uploadedBy StaffUser @relation(fields: [uploadedByStaffId], references: [id], onDelete: Restrict)
  leads      Lead[]

  @@index([uploadedByStaffId])
  @@index([createdAt])
  @@map("lead_import_batches")
}


