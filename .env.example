# Copy this file to .env at the repository root and replace the placeholders.
# Never commit the resulting .env file.

# Runtime
# NODE_ENV defaults to development for local runs. Set NODE_ENV=production in
# the deployment platform; do not put production secrets in this file.

# API
API_HOST=127.0.0.1
API_PORT=4000

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# PostgreSQL connection used by Prisma and the API.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://aurelia:local_dev_only@127.0.0.1:55432/aurelia_dev?schema=public

# Security & Sessions
# 32+ byte secret used for HMAC-SHA256 double-submit CSRF verification
CSRF_SECRET=aurelia-dealership-csrf-secret-key-lucknow-2026

# Seeded demo credentials for evaluator quick-fill (development only)
AURELIA_DEMO_PASSWORD=Aurelia2026!
VITE_DEMO_PASSWORD=Aurelia2026!

# Operations & SLA Configuration
# Target first-human-response SLA window in minutes (defaults to 30)
LEAD_RESPONSE_SLA_MINUTES=30

# Optional AI Assistance Provider
# The platform includes a deterministic, database-grounded domain engine that runs
# with zero external dependencies and zero cost. If an external LLM is desired for
# draft responses, supply a Gemini or compatible key here.
# AI_API_KEY=your-gemini-api-key-here

# Public base URL for the API. Used by the Vite development proxy and future
# browser API clients. Do not include secrets in VITE_* variables: they are
# exposed to the browser at build time.
VITE_API_URL=http://localhost:4000
